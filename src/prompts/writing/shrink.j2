{% extends "_base/base-system.j2" %}
{% import "_base/base-style-constraint.j2" as style %}
{% import "_base/base-de-ai.j2" as de_ai %}

{% block content %}
## 任务：缩写指定文本

请对给定文本进行缩写，精简冗余描写、合并同类信息、提炼核心情节，保持故事主线清晰。

### 待缩写文本
{{ content }}

### 缩写方向
{{ direction | default("精简冗余描写，合并同类信息，保留核心情节与人物动作") }}

### 本章大纲梗概
{{ chapter_synopsis | default("（无大纲梗概）") }}

{% if naming_favorites and naming_favorites|length > 0 %}
### 作者命名库（命名生成器收藏的候选名称）
{% for t, names in naming_favorites.items() %}
- {{ t }}：{{ names | join("、") }}
{% endfor %}
使用规则：缩写中保留的地点、势力/门派、功法/技能、物品名称，须与作者命名库保持一致。
{% endif %}

{% if user_ideas and user_ideas.strip() %}
### 作者补充说明
{{ user_ideas }}

{% endif %}
{{ style.inject_style(style_features) }}

{{ de_ai.inject_de_ai() }}

### 缩写要求
1. 保留核心情节、关键人物动作与对话要点
2. 不得改变故事走向与人物关系
3. 缩写后内容须 ≥{{ min_length | default(50) }} 字
4. 不得简单删字，须重新组织语言使行文流畅
5. 目标缩写至约 {{ target_words | default(0) }} 字（0 表示不限定，按需精简）

### 输出格式
```json
{
  "content": "缩写后的完整内容",
  "word_count": 600
}
```
{% endblock %}