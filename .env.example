"""AiBooks 配置示例文件 - 复制为 .env 使用"""

# AI 接口默认参数
AIBOOKS_AI_DEFAULT_TIMEOUT=60
AIBOOKS_AI_DEFAULT_MAX_RETRIES=3

# 数据库
AIBOOKS_DB_URL=sqlite+aiosqlite:///data/aibooks.db

# API 服务器
AIBOOKS_API_HOST=127.0.0.1
AIBOOKS_API_PORT=8765

# 日志
AIBOOKS_LOG_LEVEL=INFO

# 导入限制
AIBOOKS_IMPORT_MAX_FILE_SIZE_MB=50
AIBOOKS_FEED_MAX_TOTAL_SIZE_MB=200
AIBOOKS_FEED_MIN_SINGLE_CHARS=1000